APP_NAME=MedBandhu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# --- MedBandhu ---
# Platform super admin — set a strong password before running db:seed.
SUPER_ADMIN_EMAIL=you@medbandhu.com
SUPER_ADMIN_PASSWORD=

# One-click public demo (GET /demo). Turn off in a hardened production.
DEMO_MODE=true
DEMO_EMAIL=demo@medbandhu.test

# Shown on the marketing site / landing page.
MEDBANDHU_PHONE="+91 00000 00000"
MEDBANDHU_WHATSAPP="910000000000"
MEDBANDHU_EMAIL="hello@medbandhu.com"
MEDBANDHU_ADDRESS="Ranchi, Jharkhand, India"

# Where hospitals send subscription payments (manual/offline flow).
MEDBANDHU_PAY_UPI=
MEDBANDHU_PAY_AC_NAME="MedBandhu"
MEDBANDHU_PAY_BANK=
MEDBANDHU_PAY_AC_NUMBER=
MEDBANDHU_PAY_IFSC=

# Platform (SaaS) billing gateway — leave blank to keep online payments disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@medbandhu.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
